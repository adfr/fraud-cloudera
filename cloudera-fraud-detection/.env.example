# =============================================================================
# Fraud Detection System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# CML (Cloudera Machine Learning) Deployment
# -----------------------------------------------------------------------------
# Required for: python deploy_model.py

# Your CML workspace URL
CML_API_HOST=https://ml-12345.cloudera.site

# API key: CML UI -> User Settings -> API Keys -> Create
CML_API_KEY=your_api_key_here

# Project ID: check URL in project, or run: echo $CDSW_PROJECT_ID
CML_PROJECT_ID=your_project_id_here

# Runtime ID (optional - default provided)
CML_RUNTIME_ID=docker.repository.cloudera.com/cloudera/cdsw/ml-runtime-pbj-jupyterlab-python3.10-standard:2025.01.2-b15

# -----------------------------------------------------------------------------
# Kaggle API (for downloading Credit Card Fraud dataset)
# -----------------------------------------------------------------------------
# Required for: python scripts/download_kaggle_data.py
# Get credentials: kaggle.com -> Settings -> API -> Create New Token
#
# Alternative: place kaggle.json or kaggle.yaml in project root

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# -----------------------------------------------------------------------------
# CrewAI Multi-Agent Analysis (optional)
# -----------------------------------------------------------------------------
# Only needed for deep fraud investigation with AI agents

# OpenAI API key for LLM analysis
OPENAI_API_KEY=sk-your_openai_key_here

# Serper API key for web search (serper.dev)
SERPER_API_KEY=your_serper_key_here

# -----------------------------------------------------------------------------
# Resource Defaults (optional)
# -----------------------------------------------------------------------------
DEFAULT_CPU=1
DEFAULT_MEMORY=2
DEFAULT_TIMEOUT=3600
