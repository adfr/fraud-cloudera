{
  "flowContents": {
    "identifier": "fraud-detection-flow",
    "name": "Credit Card Fraud Detection Pipeline",
    "comments": "NiFi flow for processing credit card transactions and invoking ML fraud detection model",
    "processGroups": [],
    "remoteProcessGroups": [],
    "processors": [
      {
        "identifier": "generate-transactions",
        "name": "Generate Test Transactions",
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.0"
        },
        "properties": {
          "generate-ff-custom-text": "${transaction_json}",
          "Batch Size": "1",
          "Data Format": "Text",
          "Unique FlowFiles": "true",
          "character-set": "UTF-8"
        },
        "schedulingPeriod": "5 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "comments": "Generates sample transactions for testing. Replace with real transaction source.",
        "position": {
          "x": 100,
          "y": 100
        }
      },
      {
        "identifier": "execute-script-generate",
        "name": "Generate Random Transaction",
        "type": "org.apache.nifi.processors.standard.ExecuteScript",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.0"
        },
        "properties": {
          "Script Engine": "python",
          "Script Body": "import json\nimport random\nfrom datetime import datetime\nfrom java.io import BufferedReader, InputStreamReader, BufferedWriter, OutputStreamWriter\nfrom org.apache.nifi.processor.io import StreamCallback\n\nclass GenerateTransaction(StreamCallback):\n    def __init__(self):\n        pass\n    \n    def process(self, inputStream, outputStream):\n        # Transaction types\n        trans_types = ['Chip Transaction', 'Swipe Transaction', 'Online Transaction']\n        states = ['CA', 'TX', 'NY', 'FL', 'IL', 'PA', 'OH', 'GA', 'NC', 'MI']\n        mccs = [5411, 5541, 5812, 5912, 5311, 5999, 7011, 4111, 5732, 5944]\n        \n        now = datetime.now()\n        trans_type = random.choice(trans_types)\n        is_online = trans_type == 'Online Transaction'\n        \n        transaction = {\n            'User': random.randint(1, 500),\n            'Card': random.randint(0, 2),\n            'Year': now.year,\n            'Month': now.month,\n            'Day': now.day,\n            'Time': f'{now.hour:02d}:{now.minute:02d}',\n            'Amount': f'${random.uniform(10, 500):.2f}',\n            'Use Chip': trans_type,\n            'Merchant Name': f'MERCHANT_{random.randint(1000, 9999)}',\n            'Merchant City': '' if is_online else f'CITY_{random.randint(1, 100)}',\n            'Merchant State': '' if is_online else random.choice(states),\n            'Zip': '' if is_online else f'{random.randint(10000, 99999)}',\n            'MCC': random.choice(mccs),\n            'transaction_id': f'TXN_{now.strftime(\"%Y%m%d%H%M%S\")}_{random.randint(1000, 9999)}'\n        }\n        \n        writer = BufferedWriter(OutputStreamWriter(outputStream, 'UTF-8'))\n        writer.write(json.dumps(transaction))\n        writer.flush()\n        writer.close()\n\nflowFile = session.get()\nif flowFile is not None:\n    flowFile = session.write(flowFile, GenerateTransaction())\n    flowFile = session.putAttribute(flowFile, 'mime.type', 'application/json')\n    session.transfer(flowFile, REL_SUCCESS)"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "comments": "Generates random transaction JSON for testing",
        "position": {
          "x": 350,
          "y": 100
        }
      },
      {
        "identifier": "extract-transaction-attrs",
        "name": "Extract Transaction Attributes",
